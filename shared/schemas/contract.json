{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReportSaathiAPIContract",
  "version": "1.0.0",
  "definitions": {
    "HealthResponse": {
      "type": "object",
      "required": ["status", "version", "database_status", "database_value", "ocr_engine_available", "supported_panels", "timestamp"],
      "properties": {
        "status": { "type": "string", "enum": ["healthy", "degraded", "unhealthy"] },
        "version": { "type": "string" },
        "database_status": { "type": "string", "enum": ["connected", "disconnected", "error"] },
        "database_value": { "type": "string" },
        "ocr_engine_available": { "type": "boolean" },
        "supported_panels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timestamp": { "type": "string" }
      }
    },
    "RangeStatus": {
      "type": "string",
      "enum": ["WITHIN_LAB_RANGE", "OUTSIDE_LAB_RANGE", "INDETERMINATE"]
    },
    "BiomarkerExtraction": {
      "type": "object",
      "required": ["parameter_code", "display_name_en", "display_name_hi", "observed_value", "unit", "status", "ocr_confidence"],
      "properties": {
        "parameter_code": { "type": "string" },
        "display_name_en": { "type": "string" },
        "display_name_hi": { "type": "string" },
        "observed_value": { "type": "number" },
        "unit": { "type": "string" },
        "lab_range_low": { "type": ["number", "null"] },
        "lab_range_high": { "type": ["number", "null"] },
        "status": { "$ref": "#/definitions/RangeStatus" },
        "ocr_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "VerificationPayload": {
      "type": "object",
      "required": ["session_id", "confirmed_parameters"],
      "properties": {
        "session_id": { "type": "string" },
        "language": { "type": "string", "default": "en" },
        "confirmed_parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["parameter_code", "observed_value", "unit"],
            "properties": {
              "parameter_code": { "type": "string" },
              "observed_value": { "type": "number" },
              "unit": { "type": "string" },
              "lab_range_low": { "type": ["number", "null"] },
              "lab_range_high": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "DoctorQuestion": {
      "type": "object",
      "required": ["id", "question_en", "question_hi"],
      "properties": {
        "id": { "type": "string" },
        "question_en": { "type": "string" },
        "question_hi": { "type": "string" }
      }
    },
    "DecodedBiomarker": {
      "type": "object",
      "required": ["parameter_code", "name_en", "name_hi", "observed_value", "unit", "lab_range", "status_tag", "plain_explanation_en", "plain_explanation_hi"],
      "properties": {
        "parameter_code": { "type": "string" },
        "name_en": { "type": "string" },
        "name_hi": { "type": "string" },
        "observed_value": { "type": "number" },
        "unit": { "type": "string" },
        "lab_range": { "type": "string" },
        "status_tag": { "type": "string" },
        "plain_explanation_en": { "type": "string" },
        "plain_explanation_hi": { "type": "string" }
      }
    },
    "FinalReportCard": {
      "type": "object",
      "required": ["session_id", "summary", "decoded_biomarkers", "doctor_questions", "statutory_disclaimer", "whatsapp_payload"],
      "properties": {
        "session_id": { "type": "string" },
        "summary": {
          "type": "object",
          "required": ["line_1", "line_2", "line_3"],
          "properties": {
            "line_1": { "type": "string" },
            "line_2": { "type": "string" },
            "line_3": { "type": "string" }
          }
        },
        "decoded_biomarkers": {
          "type": "array",
          "items": { "$ref": "#/definitions/DecodedBiomarker" }
        },
        "doctor_questions": {
          "type": "array",
          "items": { "$ref": "#/definitions/DoctorQuestion" }
        },
        "statutory_disclaimer": { "type": "string" },
        "whatsapp_payload": {
          "type": "object",
          "required": ["encoded_url", "plain_text"],
          "properties": {
            "encoded_url": { "type": "string" },
            "plain_text": { "type": "string" }
          }
        }
      }
    },
    "StandardError": {
      "type": "object",
      "required": ["success", "error"],
      "properties": {
        "success": { "type": "boolean", "enum": [false] },
        "error": {
          "type": "object",
          "required": ["code", "message", "timestamp"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "suggested_action": { "type": "string" },
            "timestamp": { "type": "string" }
          }
        }
      }
    }
  }
}
